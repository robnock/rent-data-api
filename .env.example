# Copy to `.env` (in repo root) and fill in real values.
# `.env` is gitignored; `.env.example` is committed.

# --- API ---
# Local: Homebrew Postgres. Production (Supabase): use Project Settings → Database URI,
# then postgresql+psycopg://...?sslmode=require — see docs/deploy-managed-stack.md
DATABASE_URL=postgresql+psycopg://localhost:5432/econ_data

# Comma-separated list of origins allowed to call the API from a browser.
# In dev this is the Next.js dev server.
CORS_ALLOW_ORIGINS=http://localhost:3000

# When true, `/datasets*` requires `X-API-Key` (see `scripts/issue_api_key.py`).
API_AUTH_REQUIRED=false

# --- Web ---
# Where the browser should send API requests. Used by the Next.js app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only: forwarded on catalog fetches when `API_AUTH_REQUIRED=true` (never
# use NEXT_PUBLIC_* for secrets).
ECON_API_KEY=
